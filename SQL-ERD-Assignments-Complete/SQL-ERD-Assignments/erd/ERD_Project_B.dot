digraph ERD {graph [fontname="DejaVu Sans",rankdir=LR,bgcolor="white",splines=polyline,nodesep="0.9",ranksep="1.55",pad="0.3",labeljust=l,labelloc=t]; node [shape=plain]; edge [color="#447b91",penwidth=1.8,arrowsize=.8,fontname="DejaVu Sans",fontsize=10];
Students [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" COLOR="#8aa0ac" BGCOLOR="white"><TR><TD BGCOLOR="#174b65" CELLPADDING="10"><FONT COLOR="white" FACE="DejaVu Sans" POINT-SIZE="16"><B>Students</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans" POINT-SIZE="11"><B>StudentID</B> : INT [PK]</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans" POINT-SIZE="11">FirstName : VARCHAR(50)</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans" POINT-SIZE="11">LastName : VARCHAR(50)</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans" POINT-SIZE="11">Email : VARCHAR(100)</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans" POINT-SIZE="11">BirthDate : DATE</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans" POINT-SIZE="11">Faculty : VARCHAR(100)</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans" POINT-SIZE="11">EnrollmentYear : INT</FONT></TD></TR></TABLE>>];
Instructors [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" COLOR="#8aa0ac" BGCOLOR="white"><TR><TD BGCOLOR="#174b65" CELLPADDING="10"><FONT COLOR="white" FACE="DejaVu Sans" POINT-SIZE="16"><B>Instructors</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans" POINT-SIZE="11"><B>InstructorID</B> : INT [PK]</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans" POINT-SIZE="11">FirstName : VARCHAR(50)</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans" POINT-SIZE="11">LastName : VARCHAR(50)</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans" POINT-SIZE="11">Department : VARCHAR(100)</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans" POINT-SIZE="11">Email : VARCHAR(100)</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans" POINT-SIZE="11">Salary : DECIMAL(10,2)</FONT></TD></TR></TABLE>>];
Courses [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" COLOR="#8aa0ac" BGCOLOR="white"><TR><TD BGCOLOR="#174b65" CELLPADDING="10"><FONT COLOR="white" FACE="DejaVu Sans" POINT-SIZE="16"><B>Courses</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans" POINT-SIZE="11"><B>CourseID</B> : INT [PK]</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans" POINT-SIZE="11">CourseName : VARCHAR(100)</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans" POINT-SIZE="11">Credits : INT</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans" POINT-SIZE="11">Semester : VARCHAR(20)</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans" POINT-SIZE="11">InstructorID : INT [FK]</FONT></TD></TR></TABLE>>];
Enrollments [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" COLOR="#8aa0ac" BGCOLOR="white"><TR><TD BGCOLOR="#174b65" CELLPADDING="10"><FONT COLOR="white" FACE="DejaVu Sans" POINT-SIZE="16"><B>Enrollments</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans" POINT-SIZE="11"><B>EnrollmentID</B> : INT [PK]</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans" POINT-SIZE="11">StudentID : INT [FK]</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans" POINT-SIZE="11">CourseID : INT [FK]</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans" POINT-SIZE="11">EnrollmentDate : DATE</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans" POINT-SIZE="11">Grade : DECIMAL(5,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans" POINT-SIZE="11">Status : VARCHAR(20)</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans" POINT-SIZE="11"><B>UNIQUE(StudentID, CourseID)</B></FONT></TD></TR></TABLE>>];
Instructors -> Courses [taillabel="1",headlabel="0..N",label="InstructorID"];
Students -> Enrollments [taillabel="1",headlabel="0..N",label="StudentID"];
Courses -> Enrollments [taillabel="1",headlabel="0..N",label="CourseID"];

label="PROJECT B — UNIVERSITY REGISTRATION  |  Students M:N Courses via Enrollments; one registration per student-course pair";fontsize=13;fontname="DejaVu Sans";}