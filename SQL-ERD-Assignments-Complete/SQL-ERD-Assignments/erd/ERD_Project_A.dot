digraph ERD {graph [fontname="DejaVu Sans",rankdir=LR,bgcolor="white",splines=polyline,nodesep="0.9",ranksep="1.55",pad="0.3",labeljust=l,labelloc=t]; node [shape=plain]; edge [color="#447b91",penwidth=1.8,arrowsize=.8,fontname="DejaVu Sans",fontsize=10];
Customers [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" COLOR="#8aa0ac" BGCOLOR="white"><TR><TD BGCOLOR="#174b65" CELLPADDING="10"><FONT COLOR="white" FACE="DejaVu Sans" POINT-SIZE="16"><B>Customers</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans" POINT-SIZE="11"><B>CustomerID</B> : INTEGER [PK]</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans" POINT-SIZE="11">FirstName : VARCHAR(50)</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans" POINT-SIZE="11">LastName : VARCHAR(50)</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans" POINT-SIZE="11">Country : VARCHAR(50)</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans" POINT-SIZE="11">Score : INTEGER</FONT></TD></TR></TABLE>>];
Products [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" COLOR="#8aa0ac" BGCOLOR="white"><TR><TD BGCOLOR="#174b65" CELLPADDING="10"><FONT COLOR="white" FACE="DejaVu Sans" POINT-SIZE="16"><B>Products</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans" POINT-SIZE="11"><B>ProductID</B> : INTEGER [PK]</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans" POINT-SIZE="11">Product : VARCHAR(100)</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans" POINT-SIZE="11">Category : VARCHAR(50)</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans" POINT-SIZE="11">Price : DECIMAL(10,2)</FONT></TD></TR></TABLE>>];
Employees [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" COLOR="#8aa0ac" BGCOLOR="white"><TR><TD BGCOLOR="#174b65" CELLPADDING="10"><FONT COLOR="white" FACE="DejaVu Sans" POINT-SIZE="16"><B>Employees</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans" POINT-SIZE="11"><B>EmployeeID</B> : INTEGER [PK]</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans" POINT-SIZE="11">FirstName : VARCHAR(50)</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans" POINT-SIZE="11">LastName : VARCHAR(50)</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans" POINT-SIZE="11">Department : VARCHAR(50)</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans" POINT-SIZE="11">BirthDate : DATE</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans" POINT-SIZE="11">Gender : VARCHAR(10)</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans" POINT-SIZE="11">Salary : DECIMAL(10,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans" POINT-SIZE="11">ManagerID : INTEGER [FK, NULL]</FONT></TD></TR></TABLE>>];
Orders [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" COLOR="#8aa0ac" BGCOLOR="white"><TR><TD BGCOLOR="#174b65" CELLPADDING="10"><FONT COLOR="white" FACE="DejaVu Sans" POINT-SIZE="16"><B>Orders</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans" POINT-SIZE="11"><B>OrderID</B> : INTEGER [PK]</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans" POINT-SIZE="11">ProductID : INTEGER [FK]</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans" POINT-SIZE="11">CustomerID : INTEGER [FK]</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans" POINT-SIZE="11">SalesPersonID : INTEGER [FK]</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans" POINT-SIZE="11">OrderDate : DATE</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans" POINT-SIZE="11">ShipDate : DATE [NULL]</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans" POINT-SIZE="11">OrderStatus : VARCHAR(30)</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans" POINT-SIZE="11">ShipAddress : VARCHAR(150) [NULL]</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans" POINT-SIZE="11">BillAddress : VARCHAR(150) [NULL]</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans" POINT-SIZE="11">Quantity : INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans" POINT-SIZE="11">Sales : DECIMAL(10,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans" POINT-SIZE="11">CreationTime : DATETIME</FONT></TD></TR></TABLE>>];
Customers -> Orders [taillabel="1",headlabel="0..N",label="CustomerID",minlen=1];
Products -> Orders [taillabel="1",headlabel="0..N",label="ProductID",minlen=1];
Employees -> Orders [taillabel="1",headlabel="0..N",label="SalesPersonID",minlen=1];
Employees -> Employees [taillabel="0..1 manager",headlabel="0..N reports",label="ManagerID",constraint=false];

label="PROJECT A — SALES MANAGEMENT  |  Each order has exactly one customer, product and salesperson; manager is optional";fontsize=13;fontname="DejaVu Sans";}